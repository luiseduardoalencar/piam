# Dados
# Regra geral: ignora todos os dados.
data/**

# Mantém somente os artefatos necessários para a aplicação Streamlit.
# Ao gerar vN nova (predict / feature-impact / forecast), atualize os caminhos abaixo
# para não voltar a versionar histórico inteiro no Git.
!data/processed/
!data/processed/elgin/
!data/processed/elgin/feature-impact/
!data/processed/elgin/forecast/
!data/processed/elgin/predict/

# Correlação: ignora todas as pastas vN em feature-impact, exceto v5 (CSV mensal).
data/processed/elgin/feature-impact/*
!data/processed/elgin/feature-impact/v5/
data/processed/elgin/feature-impact/v5/*
!data/processed/elgin/feature-impact/v5/*/
data/processed/elgin/feature-impact/v5/*/*
!data/processed/elgin/feature-impact/v5/*/*.csv

# Previsão (forecast): só o CSV da versão publicada (ajuste se mudar).
data/processed/elgin/forecast/*
!data/processed/elgin/forecast/v2/
data/processed/elgin/forecast/v2/*
!data/processed/elgin/forecast/v2/sinistralidade_forecast_completo.csv

# Predição: só uma pasta vN (ajuste v20 ao publicar novo treino).
data/processed/elgin/predict/*
!data/processed/elgin/predict/v20/
data/processed/elgin/predict/v20/*
!data/processed/elgin/predict/v20/catalogo_features_intervencao.json
!data/processed/elgin/predict/v20/models/
data/processed/elgin/predict/v20/models/*
!data/processed/elgin/predict/v20/models/*.pkl
!data/processed/elgin/predict/v20/what_if_mensal/
data/processed/elgin/predict/v20/what_if_mensal/*
!data/processed/elgin/predict/v20/what_if_mensal/*.json
!data/processed/elgin/predict/v20/what_if_mensal/*.csv

# Mantém exemplos da pasta raw, se existirem.
!data/raw/
!data/raw/.gitkeep
!data/raw/exemplo_receitas.csv

# Painel analítico (parquet) — necessário para KPIs reais no Streamlit Cloud e pipelines locais
!data/raw/elgin/
!data/raw/elgin/base_analitica/
!data/raw/elgin/base_analitica/painel_sinistralidade_v1.parquet

# Catálogo de features (pipelines predict / what-if) — obrigatório no deploy
!data/auxiliar/
!data/auxiliar/elgin/
!data/auxiliar/elgin/feature_catalog.csv

# ── CLIMAZON ────────────────────────────────────────────────────────────────

!data/processed/climazon/

# Correlação: só os CSVs por plano da versão mais recente (v3).
# Versões anteriores e subpastas mensais são ignoradas.
!data/processed/climazon/feature_impact/
data/processed/climazon/feature_impact/*
!data/processed/climazon/feature_impact/v3/
data/processed/climazon/feature_impact/v3/*
!data/processed/climazon/feature_impact/v3/MASTER_EMPRESARIAL/
data/processed/climazon/feature_impact/v3/MASTER_EMPRESARIAL/*
!data/processed/climazon/feature_impact/v3/MASTER_EMPRESARIAL/corr_rank_spearman_vs_target_MASTER_EMPRESARIAL.csv
!data/processed/climazon/feature_impact/v3/MASTER_EXECUTIVO/
data/processed/climazon/feature_impact/v3/MASTER_EXECUTIVO/*
!data/processed/climazon/feature_impact/v3/MASTER_EXECUTIVO/corr_rank_spearman_vs_target_MASTER_EXECUTIVO.csv

# Predição: só v6 (ajuste ao publicar novo treino).
!data/processed/climazon/predict/
data/processed/climazon/predict/*
!data/processed/climazon/predict/v6/
data/processed/climazon/predict/v6/*
!data/processed/climazon/predict/v6/catalogo_features_intervencao.json
!data/processed/climazon/predict/v6/models/
data/processed/climazon/predict/v6/models/*
!data/processed/climazon/predict/v6/models/*.pkl
!data/processed/climazon/predict/v6/what_if_mensal/
data/processed/climazon/predict/v6/what_if_mensal/*
!data/processed/climazon/predict/v6/what_if_mensal/resultado_what_if.json

# Forecast: só os CSVs de v4 — modelos (.keras, .npy, .pkl) e imagens ficam fora.
!data/processed/climazon/forecast/
data/processed/climazon/forecast/*
!data/processed/climazon/forecast/v4/
data/processed/climazon/forecast/v4/*
!data/processed/climazon/forecast/v4/MASTER_EMPRESARIAL/
data/processed/climazon/forecast/v4/MASTER_EMPRESARIAL/*
!data/processed/climazon/forecast/v4/MASTER_EMPRESARIAL/sinistralidade_forecast_completo.csv
!data/processed/climazon/forecast/v4/MASTER_EXECUTIVO/
data/processed/climazon/forecast/v4/MASTER_EXECUTIVO/*
!data/processed/climazon/forecast/v4/MASTER_EXECUTIVO/sinistralidade_forecast_completo.csv
!data/processed/climazon/forecast/v4/consolidado/
data/processed/climazon/forecast/v4/consolidado/*
!data/processed/climazon/forecast/v4/consolidado/sinistralidade_forecast_completo.csv

# Painel processado (parquet) — necessário para Predição e Correlação.
!data/processed/climazon/base_analitica_transformada/
data/processed/climazon/base_analitica_transformada/*
!data/processed/climazon/base_analitica_transformada/painel_sinistralidade_climazon_v1.parquet

# Catálogo de features Climazon
!data/auxiliar/climazon/
!data/auxiliar/climazon/feature_catalog.csv

# ── FIM CLIMAZON ─────────────────────────────────────────────────────────────

# Ficheiros temporários locais (não enviar ao remoto)
/tmp_interv.json

mvp/